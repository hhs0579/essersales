# =============================================================================
# essersales — NAS / production deployment (Phase 4)
# Copy to .env on the NAS host. DO NOT commit real passwords to git.
# =============================================================================

# --- PostgreSQL (db service) ---
POSTGRES_DB=essersales
POSTGRES_USER=essersales
POSTGRES_PASSWORD=CHANGE_ME

# Backend reads DB_* (mapped from POSTGRES_* in compose)
DB_HOST=db
DB_PORT=5432
DB_NAME=essersales
DB_USER=essersales
DB_PASSWORD=CHANGE_ME

# --- Backend API (internal, not exposed) ---
NODE_ENV=production
API_PORT=3001
UPLOAD_DIR=/app/data/uploads
EXPORT_DIR=/app/data/exports
MIGRATIONS_DIR=/app/infra/db

# --- nginx proxy (external entry point) ---
HTTP_PORT=8080

# --- Vue build (npm run build:production) ---
VITE_API_MODE=pg
VITE_KPI_SOURCE=server
VITE_SERVER_KPI_ONLY=true
VITE_LAZY_DETAIL_LOAD=true
VITE_WRITE_API_MODE=pg
VITE_EXPORT_API_MODE=pg
VITE_PG_API_BASE=/api/v1

# Optional: restrict CORS in future
# ALLOWED_ORIGINS=http://NAS_IP:8080

# Rollback reference only — legacy SQLite API is archived, not used at runtime.
# See docs/phase-3-4b-legacy-removal.md §12

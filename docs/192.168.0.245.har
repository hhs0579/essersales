            "text": ".period-dashboard[data-v-a32270de]{display:flex;flex-direction:column;gap:12px}.toolbar[data-v-a32270de]{display:flex;flex-wrap:wrap;gap:12px;align-items:flex-start}.filter-group[data-v-a32270de]{display:flex;flex-wrap:wrap;gap:8px}.platform-filter[data-v-a32270de]{min-width:160px;padding:8px 10px;border:1px solid var(--border);border-radius:8px;font-size:.875rem}.filter-summary[data-v-a32270de]{margin:0;font-size:.8rem;color:var(--muted)}.manual-ad-note[data-v-a32270de]{margin:4px 0 0;font-size:.78rem;color:var(--primary);font-weight:600}.reconcile-note[data-v-a32270de]{margin:0;font-size:.78rem;color:var(--muted)}.reconcile-note .warn[data-v-a32270de]{color:var(--danger);font-weight:600}.reconcile-note .hint[data-v-a32270de]{color:var(--muted)}.kpi-section-title[data-v-a32270de]{margin:8px 0 0;font-size:.8rem;font-weight:600;color:var(--muted)}.kpi-grid[data-v-a32270de]{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}.kpi-grid-profit[data-v-a32270de]{grid-template-columns:repeat(auto-fit,minmax(130px,1fr))}.kpi-roas-pair[data-v-a32270de]{display:grid;grid-template-columns:1fr 1fr;gap:10px;grid-column:1 / -1}.kpi-card-roas[data-v-a32270de]{background:#f5f3ff;border-color:#c4b5fd}.kpi-split-table .th-roas[data-v-a32270de],.kpi-split-table .td-roas[data-v-a32270de]{background:#f5f3ff}.kpi-card[data-v-a32270de]{border:1px solid var(--border);border-radius:8px;padding:12px;background:var(--surface)}.kpi-label[data-v-a32270de]{display:block;font-size:.8rem;font-weight:600;margin-bottom:2px}.kpi-hint[data-v-a32270de]{display:block;font-size:.7rem;color:var(--muted);margin-bottom:6px}.kpi-value[data-v-a32270de]{font-size:1.05rem;font-variant-numeric:tabular-nums}.chart-empty[data-v-a32270de]{padding:24px}.kpi-split-wrap[data-v-a32270de]{overflow-x:auto}.dod-caption[data-v-a32270de]{margin:0;padding:10px 12px 0;font-size:.8rem;color:var(--muted)}.dod-pct[data-v-a32270de]{font-weight:700}.dod-table .row-up .dod-pct[data-v-a32270de]{color:#047857}.dod-table .row-down .dod-pct[data-v-a32270de]{color:#dc2626}.kpi-split-table[data-v-a32270de]{width:100%;border-collapse:collapse;font-size:.82rem}.kpi-split-table th[data-v-a32270de],.kpi-split-table td[data-v-a32270de]{border:1px solid var(--border);padding:8px 10px;text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}.kpi-split-table th[scope=col][data-v-a32270de],.kpi-split-table th[scope=row][data-v-a32270de]{text-align:center;background:#f8fafc;font-weight:600}.kpi-split-table .row-total[data-v-a32270de]{background:#f0f9ff;font-weight:600}.kpi-split-table .row-external[data-v-a32270de]{background:#fffbeb}.kpi-split-table .row-active[data-v-a32270de]{outline:2px solid var(--primary);outline-offset:-2px}.kpi-split-table .row-count[data-v-a32270de]{display:block;font-size:.68rem;font-weight:400;color:var(--muted)}\n"

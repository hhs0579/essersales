e{flex:1;min-width:160px;font-weight:500}.mapping-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}.mapping-row{display:flex;flex-direction:column;gap:4px}.mapping-row label{font-size:.8rem;font-weight:500}.mapping-row .hint{font-size:.7rem;color:var(--muted)}.stats{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:12px;font-size:.875rem}.stats strong{color:var(--primary)}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.upload-zone{border:2px dashed var(--border);border-radius:var(--radius);padding:32px;text-align:center;cursor:pointer;transition:border-color .15s,background .15s}.upload-zone:hover,.upload-zone.dragover{border-color:var(--primary);background:#eff6ff}.upload-zone input{display:none}.standard-ref{font-size:.8rem;color:var(--muted)}.standard-ref table{margin-top:8px;font-size:.75rem}.standard-ref th,.standard-ref td{padding:4px 8px}.section-divider{border:none;border-top:1px solid var(--border);margin:32px 0 24px}.section-heading{font-size:1.125rem;font-weight:600;margin:0 0 16px}\n"

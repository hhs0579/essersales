# =============================================================================
# essersales — local development (PG single stack)
# Copy to .env before: docker compose up -d api db
# =============================================================================

# --- PostgreSQL ---
DB_HOST=db
DB_PORT=5432
DB_NAME=essersales
DB_USER=essersales
DB_PASSWORD=change_me_in_production

# --- API (exposed for local dev tooling) ---
API_PORT=3002
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

# --- HTTP reverse proxy (dev compose) ---
HTTP_PORT=8080

# --- Vue dev (npm run dev) ---
VITE_API_MODE=pg
VITE_PG_API_BASE=http://localhost:3002/api/v1
VITE_KPI_SOURCE=server
# Phase 2 — 화면 KPI는 서버만 (클라 detail 재집계로 덮지 않음). false면 롤백
VITE_SERVER_KPI_ONLY=true
# Phase 2 — 통합·기타도 detail await 없이 KPI 먼저. false면 예전처럼 detail 대기
VITE_LAZY_DETAIL_LOAD=true
VITE_WRITE_API_MODE=pg
VITE_EXPORT_API_MODE=pg

# Migration scripts only (archive path)
# SQLITE_PATH=./archive/legacy-sqlite-server/server/data/essersales.db
